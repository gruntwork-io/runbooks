# Ignore the binary (root only — an unanchored pattern would also swallow
# test/fixtures/runbooks/, hiding the e2e runbook fixtures from git)
/runbooks

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ignore generated files
generated/*
coverage.out
*.test
dist/
testdata/**/output
testdata/**/generated
testdata/**/empty-repo
out/
test-results/

# Keep TODOs local for now
TODO/

# Ignore taskfile.dev artifacts
.task/

# Ignore local cursor directories
.cursor*/

# Ignore local Claude Code state; the rest of .claude (such as skills) is shared
.claude/workflows/
.claude/worktrees/

# Ignore downloaded dependencies
node_modules/*

# Ignore additional binaries
resources/bin/*

# Ignore fetched boilerplate WASM artifacts (see justfile fetch-boilerplate)
resources/wasm/
resources/.boilerplate-version

# Ignore electron-vite build-time scratch configs
electron.vite.config.*.mjs

# more9s draft reports stay local; the rebuild index and its stack script are tracked
.more9s/*
!.more9s/rebuild.md
!.more9s/stack.sh
