@@ -1,10 +1,11 @@
 #!/bin/bash
 CWD="$(pwd)"
+# A cd lasts only for its own script, so this starts in the working directory.
 # macOS symlinks /tmp to /private/tmp
-if [ "$CWD" = "/tmp" ] || [[ "$CWD" == /private/tmp* ]]; then
+if [ "$CWD" = "/tmp" ] || [ "$CWD" = "/private/tmp" ]; then
+    echo "FAIL: Working directory is $CWD: the cd in change-dir carried over"
+    exit 1
+else
     echo "OK: Working directory is $CWD"
     exit 0
-else
-    echo "FAIL: Working directory is $CWD, expected /tmp"
-    exit 1
 fi
