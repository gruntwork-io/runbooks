{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "electron/main/index.ts",
    "electron/preload/index.ts",
    "electron/preload/embed.ts",
    "web/src/main.tsx",
    "cli/index.ts",
    "scripts/*.ts",
    ".github/scripts/**/*.mjs",
    "{src,electron,cli,scripts,test}/**/*.test.ts",
    "packages/cli/src/{main,writeTestFileSchema}.ts",
    "packages/app-main/src/main.ts",
    "packages/app-renderer/src/main.tsx",
    "{packages,blocks,baseline}/**/*.test.{ts,tsx}",
    "blocks/core/{contract,form,registry,status}.ts",
    "blocks/{index,views}.ts",
    "packages/core/src/{credential,document,domain,errors,plugin,services,test-utils}/**/*.ts",
    "packages/core/src/{path-validation,remote-source,types}.ts",
    "packages/core/src/engine/{handlers,inProcess,protocol,sessionStore,settings}.ts",
    "packages/cli/src/testFile.ts",
    "packages/platform-node/src/layers/**/*.ts",
    "packages/cli/src/contract.ts",
    "packages/core/src/plugin/transport.ts",
    "packages/platform-node/src/fixtures/*.ts"
  ],
  "project": [
    "{src,electron,web,cli,scripts,test}/**/*.{ts,tsx}",
    ".github/scripts/**/*.mjs",
    "{packages,blocks,baseline}/**/*.{ts,tsx}"
  ],
  "ignore": ["docs/**", "testdata/**", "test/fixtures/**"],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "web/src/components/ui/**": ["exports", "types"],
    "web/src/types/boilerplateVariable.ts": ["enumMembers"]
  },
  "ignoreBinaries": ["script", "osascript", "check"],
  "ignoreDependencies": ["tailwindcss", "tw-animate-css"],
  "vitest": {
    "config": ["web/vitest.config.ts", "vitest.integration.config.ts"]
  },
  "playwright": {
    "config": [
      "playwright.config.ts",
      "web/playwright.config.ts",
      "electron/e2e/playwright.config.ts"
    ]
  }
}
