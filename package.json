{
  "name": "runbooks",
  "version": "0.27.0",
  "private": true,
  "description": "Gruntwork Runbooks",
  "author": {
    "name": "Gruntwork",
    "email": "info@gruntwork.io"
  },
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "preview": "install-electron && electron-vite preview",
    "package": "electron-builder",
    "typecheck": "bun scripts/no-nested-node-modules.ts && bun check",
    "lint": "oxlint .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "test": "bun scripts/no-nested-node-modules.ts && bun test --path-ignore-patterns='web/**' --path-ignore-patterns='docs/**' --path-ignore-patterns='node_modules/**' --path-ignore-patterns='**/e2e/**' --path-ignore-patterns='test/**' && cd web && vitest run",
    "test:backend": "bun scripts/no-nested-node-modules.ts && bun test --path-ignore-patterns='web/**' --path-ignore-patterns='docs/**' --path-ignore-patterns='node_modules/**' --path-ignore-patterns='**/e2e/**' --path-ignore-patterns='test/**'",
    "test:web": "cd web && vitest run",
    "test:integration": "bun scripts/no-nested-node-modules.ts && vitest run --config vitest.integration.config.ts",
    "test:watch": "bun scripts/no-nested-node-modules.ts && bun test --watch src/ electron/",
    "test:coverage": "bun scripts/no-nested-node-modules.ts && bun test --coverage src/ electron/",
    "test:e2e": "bunx playwright test --config web/playwright.config.ts",
    "test:electron-e2e": "bun scripts/no-nested-node-modules.ts && bunx playwright test --config electron/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-account": "^3.1148.0",
    "@aws-sdk/client-iam": "^3.1148.0",
    "@aws-sdk/client-sso": "^3.1148.0",
    "@aws-sdk/client-sso-oidc": "^3.1148.0",
    "@aws-sdk/client-sts": "^3.1148.0",
    "@aws-sdk/credential-providers": "^3.1148.0",
    "@aws-sdk/util-endpoints": "^3.996.45",
    "@smithy/core": "^3.35.2",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "effect": "^4.0.2",
    "electron-updater": "^6.8.9",
    "google-auth-library": "^11.2.0",
    "ini": "^6.0.0",
    "mixpanel": "^0.24.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.4",
    "@mdx-js/mdx": "^3.1.1",
    "@playwright/test": "1.64.0",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/estree": "^1.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "ansi-to-react": "^6.2.6",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun-types": "^1.4.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "copy-to-clipboard": "^3.3.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^6.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "jszip": "^3.10.2",
    "knip": "^6.41.0",
    "lucide-react": "^1.49.0",
    "mixpanel-browser": "^2.84.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.8",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "packageManager": "bun@1.4.2",
  "build": {
    "appId": "io.gruntwork.runbooks",
    "productName": "Runbooks",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/wasm",
        "to": "wasm",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "gruntwork-io",
      "repo": "runbooks"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "fileAssociations": [
        {
          "ext": "mdx",
          "name": "Runbook",
          "description": "Gruntwork Runbook",
          "role": "Editor"
        }
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icons",
      "mimeTypes": [
        "text/mdx"
      ],
      "desktop": {
        "entry": "StartupWMClass=gruntwork-runbooks"
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "fileAssociations": [
        {
          "ext": "mdx",
          "name": "Runbook",
          "description": "Gruntwork Runbook"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    }
  },
  "trustedDependencies": [
    "@swc/core"
  ]
}
