{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "credential.schema.json",
  "title": "Runbooks credential plugin protocol",
  "description": "The `credential` kind: sign-in for one credential block. One process serves one block. Methods: configure, detect, signIn (with signIn.prompt notifications), targets, select, env, signOut. Exactly one method returns secret values: env. No notification, log line or error message carries one. A secret the person types travels one way, in signIn's fields. A credential that can live in a file is returned as the path of a file readable by its owner only, under stateDir. Pins and selectParams.targets are keyed by level name; a level the plugin did not declare fails with invalidParams.",
  "$defs": {
    "configureParams": {
      "allOf": [{ "$ref": "base.schema.json#/$defs/configureParams" }],
      "required": ["stateDir"],
      "properties": {
        "stateDir": {
          "description": "A private directory for this block. Files the plugin writes go here, and signOut deletes them.",
          "type": "string"
        },
        "caBundleFile": { "type": "string" },
        "proxy": { "type": "string" }
      }
    },
    "configureResult": {
      "allOf": [{ "$ref": "base.schema.json#/$defs/configureResult" }],
      "required": ["methods", "levels", "sources", "requirements", "names"],
      "properties": {
        "methods": { "type": "array", "items": { "$ref": "#/$defs/method" } },
        "levels": { "type": "array", "items": { "$ref": "#/$defs/level" } },
        "sources": {
          "description": "The detection sources the plugin names itself: cli, adc, gcloud.",
          "type": "array",
          "items": { "type": "string" }
        },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirementKind" } },
        "names": {
          "description": "Every env and output name the plugin may set. The base environment strips the env names.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["name", "label", "required", "secret"],
      "properties": {
        "name": { "type": "string" },
        "label": { "type": "string" },
        "required": { "type": "boolean" },
        "secret": { "type": "boolean" }
      }
    },
    "method": {
      "type": "object",
      "required": ["name", "label", "fields"],
      "properties": {
        "name": { "type": "string" },
        "label": { "type": "string" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
      }
    },
    "level": {
      "type": "object",
      "required": ["name", "label", "chosen"],
      "properties": {
        "name": { "type": "string" },
        "label": { "type": "string" },
        "chosen": { "enum": ["beforeSignIn", "afterSignIn"] }
      }
    },
    "requirementKind": { "enum": ["scopes", "roles"] },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "env" }, "prefix": { "type": "string" } }
        },
        {
          "description": "Values the engine read from an earlier block's outputs.",
          "type": "object",
          "required": ["kind", "values"],
          "properties": {
            "kind": { "const": "values" },
            "values": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "required": ["kind", "name"],
          "properties": { "kind": { "const": "named" }, "name": { "type": "string" } }
        }
      ]
    },
    "requirement": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "scopes"],
          "properties": {
            "kind": { "const": "scopes" },
            "scopes": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "required": ["kind", "roles"],
          "properties": {
            "kind": { "const": "roles" },
            "roles": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["role"],
                "properties": { "role": { "type": "string" }, "scope": { "type": "string" } }
              }
            }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "required": ["id", "name"],
      "properties": { "id": { "type": "string" }, "name": { "type": "string" } }
    },
    "identity": {
      "type": "object",
      "required": ["principal", "kind", "method", "targets"],
      "properties": {
        "principal": {
          "description": "An ARN, an email, an object id, a login.",
          "type": "string"
        },
        "kind": { "enum": ["user", "guest", "servicePrincipal", "serviceAccount", "role"] },
        "method": { "type": "string" },
        "targets": {
          "description": "What is selected at each level, by level name.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/target" }
        },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "pins": {
      "description": "Keyed by level name.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "detectParams": {
      "type": "object",
      "required": ["sources", "pins", "requirements"],
      "properties": {
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "pins": { "$ref": "#/$defs/pins" },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } }
      }
    },
    "detectResult": {
      "oneOf": [
        {
          "type": "object",
          "required": ["found"],
          "properties": { "found": { "const": false } }
        },
        {
          "type": "object",
          "required": ["found", "identity", "source"],
          "properties": {
            "found": { "const": true },
            "identity": { "$ref": "#/$defs/identity" },
            "source": { "description": "The source it was found in.", "type": "string" }
          }
        }
      ]
    },
    "signInParams": {
      "type": "object",
      "required": ["method", "fields", "pins", "requirements"],
      "properties": {
        "method": { "type": "string" },
        "fields": { "type": "object", "additionalProperties": { "type": "string" } },
        "pins": { "$ref": "#/$defs/pins" },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } }
      }
    },
    "signInPrompt": {
      "description": "The params of a signIn.prompt notification.",
      "type": "object",
      "required": ["request", "kind"],
      "properties": {
        "request": { "$ref": "base.schema.json#/$defs/id" },
        "kind": { "enum": ["openUrl", "showCode", "waiting"] },
        "url": { "type": "string", "format": "uri" },
        "code": { "type": "string" }
      }
    },
    "signInResult": { "$ref": "#/$defs/identity" },
    "targetsParams": {
      "type": "object",
      "required": ["level"],
      "properties": { "level": { "type": "string" }, "parent": { "type": "string" } }
    },
    "targetsResult": {
      "type": "object",
      "required": ["targets"],
      "properties": { "targets": { "type": "array", "items": { "$ref": "#/$defs/target" } } }
    },
    "selectParams": {
      "type": "object",
      "required": ["targets"],
      "properties": {
        "targets": {
          "description": "The chosen target id at each level, by level name.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "selectResult": { "$ref": "#/$defs/identity" },
    "envValue": {
      "type": "object",
      "required": ["name", "value", "sensitive", "to"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "string" },
        "sensitive": { "type": "boolean" },
        "to": { "type": "array", "items": { "enum": ["env", "output"] } }
      }
    },
    "envResult": {
      "description": "What a run gets. The plugin refreshes first if it can. A declared name that is not returned is unset.",
      "type": "object",
      "required": ["values"],
      "properties": {
        "values": { "type": "array", "items": { "$ref": "#/$defs/envValue" } },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "signOutResult": { "type": "object" },
    "errorKind": {
      "enum": [
        "notConfigured",
        "unsupportedProtocolVersion",
        "invalidParams",
        "notSignedIn",
        "expired",
        "pinMismatch",
        "requirementNotMet",
        "accessDenied",
        "cancelled",
        "timedOut",
        "network",
        "tlsError",
        "toolMissing",
        "internal"
      ]
    },
    "requirementNotMetData": {
      "type": "object",
      "required": ["kind", "unmet"],
      "properties": {
        "kind": { "const": "requirementNotMet" },
        "unmet": { "type": "array", "items": { "$ref": "#/$defs/requirement" } }
      }
    },
    "toolMissingData": {
      "type": "object",
      "required": ["kind", "tool", "installUrl"],
      "properties": {
        "kind": { "const": "toolMissing" },
        "tool": { "type": "string" },
        "installUrl": { "type": "string", "format": "uri" }
      }
    }
  }
}
