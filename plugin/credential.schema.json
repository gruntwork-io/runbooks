{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "credential.schema.json",
  "title": "Runbooks credential plugin protocol",
  "description": "The `credential` kind: sign-in for one credential block. One process serves one block. Methods: configure, detect, signIn (with signIn.prompt notifications), targets, select, env, signOut. Exactly one method returns secret values: env. No notification, log line or error message carries one. A secret the person types travels one way, in signIn's fields. A credential that can live in a file is returned as the path of a file readable by its owner only, under stateDir, in an env value marked file. Pins and selectParams.targets are keyed by level name; a level the plugin did not declare fails with invalidParams.",
  "$defs": {
    "configureParams": {
      "allOf": [{ "$ref": "base.schema.json#/$defs/configureParams" }],
      "required": ["stateDir"],
      "properties": {
        "stateDir": {
          "description": "A private directory for this block. Files the plugin writes go here, and signOut deletes them. A resumed session opens the block with the same directory after the app restarts, so a file env named before is still there.",
          "type": "string"
        },
        "caBundleFile": { "type": "string" },
        "proxy": { "type": "string" },
        "settings": {
          "description": "The block's settings, neither secret nor identity: a default region, a default zone.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "configureResult": {
      "allOf": [{ "$ref": "base.schema.json#/$defs/configureResult" }],
      "required": ["methods", "levels", "sources", "requirements", "names"],
      "properties": {
        "methods": { "type": "array", "items": { "$ref": "#/$defs/method" } },
        "levels": { "type": "array", "items": { "$ref": "#/$defs/level" } },
        "sources": {
          "description": "The detection sources the plugin names itself: cli, adc, gcloud.",
          "type": "array",
          "items": { "type": "string" }
        },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirementKind" } },
        "names": {
          "description": "Every env and output name the plugin may set. The base environment strips the env names.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["name", "label", "required", "secret"],
      "properties": {
        "name": { "type": "string" },
        "label": { "type": "string" },
        "required": { "type": "boolean" },
        "secret": { "type": "boolean" },
        "choices": {
          "description": "The values the view offers to pick from: AWS profiles. Never on a secret field. The plugin answers invalidParams for a value it did not list.",
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "properties": { "value": { "type": "string" }, "label": { "type": "string" } }
          }
        }
      }
    },
    "method": {
      "type": "object",
      "required": ["name", "label", "fields"],
      "properties": {
        "name": { "type": "string" },
        "label": { "type": "string" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "oneOf": {
          "description": "Groups of the method's field names. A sign-in gives exactly one field of each group: a client secret or a certificate. The plugin answers invalidParams for one that does not.",
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 10,
            "items": { "type": "string" }
          }
        },
        "unavailable": {
          "description": "Why the method cannot be used now: no az installed. Runbooks still lists it, with this reason, and refuses a sign-in with it.",
          "type": "object",
          "required": ["kind", "message"],
          "properties": {
            "kind": { "$ref": "#/$defs/errorKind" },
            "message": { "type": "string" }
          }
        }
      }
    },
    "level": {
      "type": "object",
      "required": ["name", "label", "chosen"],
      "properties": {
        "name": { "type": "string" },
        "label": { "type": "string" },
        "chosen": { "enum": ["beforeSignIn", "afterSignIn"] },
        "optional": {
          "description": "The person may choose no target here: an Azure tenant-level sign-in has no subscription. False when absent. A pin always names a target.",
          "type": "boolean"
        }
      }
    },
    "requirementKind": { "enum": ["scopes", "roles"] },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "env" }, "prefix": { "type": "string" } }
        },
        {
          "description": "Values the engine read from an earlier block's outputs; or, when it resumes a saved session, the values this block's own env returned before the app restarted, under the names env gave them. A plugin finds a login in values named as its env names them, and checks it as it checks any login it detects.",
          "type": "object",
          "required": ["kind", "values", "from"],
          "properties": {
            "kind": { "const": "values" },
            "values": { "type": "object", "additionalProperties": { "type": "string" } },
            "from": {
              "description": "The id of the block the values were read from: the block itself, for its own saved values. A login found in them has it as its source.",
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "name"],
          "properties": { "kind": { "const": "named" }, "name": { "type": "string" } }
        }
      ]
    },
    "requirement": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "scopes"],
          "properties": {
            "kind": { "const": "scopes" },
            "scopes": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "required": ["kind", "roles"],
          "properties": {
            "kind": { "const": "roles" },
            "roles": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["role"],
                "properties": { "role": { "type": "string" }, "scope": { "type": "string" } }
              }
            }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "required": ["id", "name"],
      "properties": { "id": { "type": "string" }, "name": { "type": "string" } }
    },
    "identity": {
      "type": "object",
      "required": ["principal", "kind", "method", "targets"],
      "properties": {
        "principal": {
          "description": "An ARN, an email, an object id, a login.",
          "type": "string"
        },
        "kind": { "enum": ["user", "guest", "servicePrincipal", "serviceAccount", "role"] },
        "method": { "type": "string" },
        "targets": {
          "description": "What is selected at each level, by level name: null at an optional level that has none.",
          "type": "object",
          "additionalProperties": { "oneOf": [{ "$ref": "#/$defs/target" }, { "type": "null" }] }
        },
        "expiresAt": { "type": "string", "format": "date-time" },
        "warnings": {
          "description": "Shown with the identity, and never fatal: a region that is not enabled.",
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["message"],
            "properties": { "message": { "type": "string" } }
          }
        }
      }
    },
    "pins": {
      "description": "Keyed by level name.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "detectParams": {
      "type": "object",
      "required": ["sources", "pins", "requirements"],
      "properties": {
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "pins": { "$ref": "#/$defs/pins" },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } }
      }
    },
    "detectResult": {
      "oneOf": [
        {
          "type": "object",
          "required": ["found", "identity", "source"],
          "properties": {
            "found": { "const": true },
            "identity": { "$ref": "#/$defs/identity" },
            "source": {
              "description": "The source it was found in: env, a named source, or a values source's from.",
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": ["found"],
          "properties": { "found": { "const": false } }
        }
      ]
    },
    "signInParams": {
      "type": "object",
      "required": ["method", "fields", "pins", "requirements"],
      "properties": {
        "method": { "type": "string" },
        "fields": { "type": "object", "additionalProperties": { "type": "string" } },
        "pins": { "$ref": "#/$defs/pins" },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } }
      }
    },
    "signInPrompt": {
      "description": "The params of a signIn.prompt notification.",
      "type": "object",
      "required": ["request", "kind"],
      "properties": {
        "request": { "$ref": "base.schema.json#/$defs/id" },
        "kind": { "enum": ["openUrl", "showCode", "waiting"] },
        "url": { "type": "string", "format": "uri" },
        "code": { "type": "string" }
      }
    },
    "signInResult": { "$ref": "#/$defs/identity" },
    "targetsParams": {
      "type": "object",
      "required": ["level"],
      "properties": { "level": { "type": "string" }, "parent": { "type": "string" } }
    },
    "targetsResult": {
      "type": "object",
      "required": ["targets"],
      "properties": { "targets": { "type": "array", "items": { "$ref": "#/$defs/target" } } }
    },
    "selectParams": {
      "type": "object",
      "required": ["targets"],
      "properties": {
        "targets": {
          "description": "The chosen target id at each level, by level name: null where an optional level has none. Null at a level that is not optional fails with invalidParams.",
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        }
      }
    },
    "selectResult": { "$ref": "#/$defs/identity" },
    "envValue": {
      "type": "object",
      "required": ["name", "value", "sensitive", "to", "file"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "string" },
        "sensitive": { "type": "boolean" },
        "to": { "type": "array", "items": { "enum": ["env", "output"] } },
        "file": {
          "description": "True when value is the absolute path of a file, or a folder, the plugin wrote under stateDir for this credential: only its owner may read it. Runbooks refuses one outside stateDir or readable by anyone else.",
          "type": "boolean"
        }
      }
    },
    "envResult": {
      "description": "What a run gets. A credential that has expired, or that expires within 5 minutes, is refreshed before env answers if the plugin can refresh it, and expiresAt is the new expiry. A declared name that is not returned is unset.",
      "type": "object",
      "required": ["values"],
      "properties": {
        "values": { "type": "array", "items": { "$ref": "#/$defs/envValue" } },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "signOutResult": { "type": "object" },
    "errorKind": {
      "enum": [
        "notConfigured",
        "unsupportedProtocolVersion",
        "invalidParams",
        "notSignedIn",
        "expired",
        "pinMismatch",
        "requirementNotMet",
        "accessDenied",
        "cancelled",
        "timedOut",
        "network",
        "tlsError",
        "toolMissing",
        "internal"
      ]
    },
    "requirementNotMetData": {
      "type": "object",
      "required": ["kind", "unmet"],
      "properties": {
        "kind": { "const": "requirementNotMet" },
        "unmet": { "type": "array", "items": { "$ref": "#/$defs/requirement" } }
      }
    },
    "toolMissingData": {
      "type": "object",
      "required": ["kind", "tool", "installUrl"],
      "properties": {
        "kind": { "const": "toolMissing" },
        "tool": { "type": "string" },
        "installUrl": { "type": "string", "format": "uri" }
      }
    }
  }
}
