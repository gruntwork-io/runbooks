{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Specs run under Node, and the callbacks they pass to page.evaluate run
    // in the renderer, so both sets of globals apply.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
  },
  "include": ["electron/e2e/**/*", "test/**/*"]
}
