// What every package in the new tree compiles with, and what each package
// exports. A package's tsconfig.json extends this file and references the
// packages it may import (scripts/packages.ts). An import resolves only
// through these paths: a subpath not listed here fails with TS2307, and a
// package the importer does not reference fails with TS6307.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "types": ["bun-types"],
    "erasableSyntaxOnly": true,
    "paths": {
      // blocks-core: blocks/core
      "@runbooks/blocks-core/contract": ["./blocks/core/contract.ts"],
      "@runbooks/blocks-core/form": ["./blocks/core/form.ts"],
      "@runbooks/blocks-core/registry": ["./blocks/core/registry.ts"],
      "@runbooks/blocks-core/status": ["./blocks/core/status.ts"],

      // blocks: blocks/, apart from blocks/core
      "@runbooks/blocks": ["./blocks/index.ts"],
      "@runbooks/blocks/views": ["./blocks/views.ts"],

      // core: packages/core
      "@runbooks/core/credential/*": ["./packages/core/src/credential/*.ts"],
      "@runbooks/core/document/*": ["./packages/core/src/document/*.ts"],
      "@runbooks/core/domain/*": ["./packages/core/src/domain/*.ts"],
      "@runbooks/core/errors": ["./packages/core/src/errors/index.ts"],
      "@runbooks/core/errors/*": ["./packages/core/src/errors/*.ts"],
      "@runbooks/core/handlers": ["./packages/core/src/engine/handlers.ts"],
      "@runbooks/core/inProcess": ["./packages/core/src/engine/inProcess.ts"],
      "@runbooks/core/path-validation": ["./packages/core/src/path-validation.ts"],
      "@runbooks/core/plugin/*": ["./packages/core/src/plugin/*.ts"],
      "@runbooks/core/protocol": ["./packages/core/src/engine/protocol.ts"],
      "@runbooks/core/remote-source": ["./packages/core/src/remote-source.ts"],
      "@runbooks/core/settings": ["./packages/core/src/engine/settings.ts"],
      "@runbooks/core/services/*": ["./packages/core/src/services/*.ts"],
      "@runbooks/core/sessionStore": ["./packages/core/src/engine/sessionStore.ts"],
      "@runbooks/core/test-utils/*": ["./packages/core/src/test-utils/*.ts"],
      "@runbooks/core/types": ["./packages/core/src/types.ts"],

      // cli: packages/cli
      "@runbooks/cli/testFile": ["./packages/cli/src/testFile.ts"],

      // platform-node: packages/platform-node
      "@runbooks/platform-node/layers/*": ["./packages/platform-node/src/layers/*.ts"]
    }
  }
}
