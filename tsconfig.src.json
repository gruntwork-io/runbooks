{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun-types"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.src.tsbuildinfo"
  },
  "include": ["src/**/*", "cli/**/*", "scripts/**/*.ts"],
  // scripts/plugins/ imports the new tree's packages by name, through its own tsconfig.json.
  "exclude": ["scripts/plugins/**"]
}
